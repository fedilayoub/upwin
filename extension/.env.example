# Optional. Copy to `.env.local`. Every value here ships in readable JavaScript:
# never put a secret here. The API token is entered in the side panel instead,
# and kept in the browser's extension storage.

# Defaults shown on first run. Each freelancer can change both in the side
# panel's Settings, so one build works against any API.
WXT_PUBLIC_API_URL=http://localhost:3002
WXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: pins the extension id, so its origin (chrome-extension://<id>) is
# the same on every machine and reinstall. Generate one with `pnpm crx:keygen`.
# Without it, an unpacked extension's id comes from its folder path.
WXT_CRX_PUBLIC_KEY=
