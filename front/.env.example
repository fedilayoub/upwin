# Copy to `.env.local` for local development, or set these in Vercel's
# project settings for an online install. Everything here is server-only:
# nothing is sent to the browser, and there are no NEXT_PUBLIC_* values.

# The API this app calls, as this server reaches it. Never expose it as
# NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3002

# The API's API_TOKEN. Required online (the API is reachable from the
# internet); leave empty when everything runs on this machine.
API_TOKEN=

# Required online. One password unlocks this app; there are no accounts.
# Clients only ever see your video links (/<lang>/v/<slug>), which stay public.
# Changing it signs every browser out. Generate one with: openssl rand -base64 24
APP_PASSWORD=

# This app's public address, e.g. https://upwin-yourname.vercel.app. Used for
# the poster in a video link's preview card. The API's APP_URL must match it.
APP_URL=http://localhost:3000
