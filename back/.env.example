# Copy to `.env`. Everything here stays on your machine: the extension and the
# web app never see these values. Never mirror them into WXT_PUBLIC_* or
# NEXT_PUBLIC_* variables.

# --- Required -------------------------------------------------------------------

# Your AI provider. The API will not start without one.
# Guide: docs/AI-PROVIDER-SETUP.md (llmgateway.io is recommended).
AI_BASE_URL=https://api.llmgateway.io/v1
AI_API_KEY=

# The web app's address, and the extension's origin. `pnpm crx:id` in
# ../extension prints the extension's origin.
APP_URL=http://localhost:3000
EXTENSION_ALLOWED_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Postgres. Not needed with docker compose, which sets it.
DATABASE_URL=postgresql://upwin:upwin@localhost:5432/upwin

# --- Online install -------------------------------------------------------------
# Required when the API is reachable from the internet. Guide: docs/DEPLOY.md.
# The extension and web app send API_TOKEN as `Authorization: Bearer <token>`.
# Generate them with: openssl rand -hex 32   and   openssl rand -base64 24
API_TOKEN=
POSTGRES_PASSWORD=

# --- AI model (optional) --------------------------------------------------------
# Leave empty for llmgateway.io or OpenAI: the built-in defaults work there.
# Set it when your provider names models differently, e.g. `llama3.1:8b` for
# Ollama or `openai/gpt-4.1-mini` for OpenRouter.
AI_MODEL=

# --- Video proposals (optional) -------------------------------------------------
# Record your screen and camera from the extension and send clients a link.
# Set all four to turn video on. Guide: docs/VIDEO-STORAGE-SETUP.md.
VIDEO_STORAGE_ENDPOINT=
VIDEO_STORAGE_BUCKET=
VIDEO_STORAGE_ACCESS_KEY_ID=
VIDEO_STORAGE_SECRET_ACCESS_KEY=
