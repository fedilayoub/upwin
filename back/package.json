{
  "name": "@upwin-community/api",
  "version": "0.1.0",
  "private": true,
  "description": "upwin community API: NestJS + Fastify + Drizzle + PostgreSQL. Self-hosted, single-user.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node dist/database/migrate.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.42",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.11",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-fastify": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "ai": "^7.0.66",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.8",
    "mammoth": "^1.13.0",
    "nestjs-zod": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.10",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  }
}
